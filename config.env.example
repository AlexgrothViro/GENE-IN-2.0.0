# ==========================================
# ARQUIVO DE CONFIGURAÇÃO - QUALI 2026
# ==========================================

# --- CONFIGURAÇÃO DA AMOSTRA ---
# Espera: data/raw/${SAMPLE_NAME}_R1.fastq.gz e _R2.fastq.gz
SAMPLE_NAME="minha_amostra"
RAW_DIR="data/raw"

# --- ESCOLHA DO MONTADOR ---
# Opções: "velvet", "spades" ou "metaspades"
ASSEMBLER="velvet"

# Threads gerais (SPAdes / BLAST)
THREADS=4

# --- PARÂMETROS DO SPAdes ---
# Nota: --rnaviral requer SPAdes >= 3.14 (compile from source ou Conda).
# Com SPAdes via apt (Ubuntu 20.04/22.04), use apenas "-k 21,33,55,77"
# Ex.: "--rnaviral -k 21,33,55,77"
SPADES_PARAMS="--rnaviral -k 21,33,55,77"

# --- PRESERVAÇÃO DE CONTIGS INTERMEDIÁRIOS ---
# Se true, preserva contigs simplificados de cada k-mer individual do SPAdes
FRAGMENT_HUNTER_KEEP_ALL_KMERS=false

# --- PARÂMETROS DO Velvet ---
# K-mer único
VELVET_K=51
# Opções extras do velvetg (opcional)
VELVET_OPTS="-exp_cov auto -cov_cutoff auto -min_contig_lgth 20"

# --- BANCO DE DADOS (CONFIGURAÇÃO DO ALVO) ---
# TaxID do NCBI (atenção: família inteira pode ficar enorme)
TARGET_TAXID="12058"
DB_NAME="viral_db"
DB_ROOT="data/db"

# Query editável (se quiser algo mais específico)
# Dica: você pode restringir por "complete genome" se ficar grande demais.
NCBI_QUERY="txid${TARGET_TAXID}[Organism:exp] AND refseq[filter]"

# Limite de registros retornados pelo esearch (para não baixar o mundo sem querer)
EDIRECT_RETMAX=500
# Recuperacao de falhas transitorias de rede no esearch/efetch.
EDIRECT_RETRIES=3
EDIRECT_RETRY_DELAY=5

# --- PARÂMETROS DO BLAST ---
BLAST_EVALUE="1e-5"
BLAST_MAX_TARGET_SEQS=20

# --- PERFIS DE BUSCA (A/B/C) ---
# Vazio = apenas o perfil A: blastn dos contigs contra o BLAST_DB direcionado.
# B = painel competitivo (exige EVIDENCE_COMPOSITE_DB curado fora do pipeline).
# C = fragmentos curtos + blastn-short no MESMO BLAST_DB.
# Combine com virgula ("A,C"). B e C nunca ligam sozinhos; o perfil efetivo
# fica gravado no run e declarado no relatorio minimo.
SEARCH_PROFILES=

# --- EXTRAÇÃO DE FRAGMENTOS CURTOS ---
# Se true, extrai contigs com tamanhos curtos para validação
SHORT_FRAGMENT_MODE=false
SHORT_FRAGMENT_MIN_LEN=20
SHORT_FRAGMENT_MAX_LEN=100
SHORT_FRAGMENT_DEDUP=true

# --- BLAST SENSÍVEL PARA FRAGMENTOS CURTOS ---
# Se true, roda blastn-short nos fragmentos curtos extraídos
# Requer SHORT_FRAGMENT_MODE=true para gerar os fragmentos antes
SHORT_FRAGMENT_BLAST=false
SHORT_FRAGMENT_WORD_SIZE=7
SHORT_FRAGMENT_EVALUE=1000
SHORT_FRAGMENT_MIN_PID=70
SHORT_FRAGMENT_MIN_QCOV=70

# Adaptadores conhecidos da biblioteca; vazio usa deteccao automatica.
# Para inserts20–34 pb, informar o adaptador evita depender de sobreposicao.
QC_ADAPTER_R1=
QC_ADAPTER_R2=
