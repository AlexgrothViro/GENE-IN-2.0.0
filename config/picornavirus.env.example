# Gene-In example profile for historical picornavirus/PTV development.
# This is not the global product scope and does not contain secrets.
# Copy/override it for the declared virus, sample and host before running.

# --- Configuracao basica ---
ASSEMBLER=spades
# Historical demo profile only; replace with the selected viral reference set.
DB=custom
BLAST_EVALUE=1e-5
BLAST_MAX_TARGET_SEQS=20

# --- Filtro de hospedeiro ---
# Safe default: do not remove a host unless the sample metadata explicitly
# authorizes a matching host profile. Sus scrofa is only a historical example.
HOST_FILTER_ENABLED=false
HOST_NAME=""
HOST_ACCESSION=""
HOST_INDEX_PREFIX=""

# --- Recursos ---
THREADS=4

# --- Rede ---
BIND_HOST="127.0.0.1"
PORT="8000"

# --- Configuracao avancada ---
SPADES_MEMORY=64
SPADES_PARAMS="-m ${SPADES_MEMORY}"

VELVET_K=31
MIN_CONTIG_LEN=20
VELVET_OPTS=""
READ_TRKG=yes

# --- Amostra / diretorios ---
SAMPLE_NAME=""
SAMPLE_ID=""
RAW_DIR="data/raw"
BLAST_DB="blastdb/custom"
HOST_REMOVED_DIR="data/host_removed"

# DB_QUERY="\"Virus name\"[Organism]"
# Recuperacao de falhas transitorias do EDirect (esearch/efetch).
EDIRECT_RETRIES=3
EDIRECT_RETRY_DELAY=5

# Adaptadores conhecidos da biblioteca; vazio usa deteccao automatica.
QC_ADAPTER_R1=
QC_ADAPTER_R2=
