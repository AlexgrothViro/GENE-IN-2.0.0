{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation-experiment-result-v1",
  "title": "ValidationExperimentResult",
  "type": "object",
  "required": [
    "run_id",
    "experiment_id",
    "parameter_set_id",
    "commit",
    "configuration",
    "sample_id",
    "status"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "experiment_id": {"type": "string"},
    "parameter_set_id": {"type": "string", "pattern": "^ps-[0-9a-f]{16}$"},
    "commit": {"type": "string"},
    "configuration": {"type": "object"},
    "sample_id": {"type": "string"},
    "ground_truth": {"type": ["string", "null"]},
    "sample_role": {"type": "string"},
    "expected_length_bp": {"type": ["integer", "null"]},
    "recovered_length_bp": {"type": ["integer", "null"]},
    "identity_pct": {"type": ["number", "null"]},
    "coverage_pct": {"type": ["number", "null"]},
    "bitscore": {"type": ["number", "null"]},
    "evalue": {"type": ["number", "null"]},
    "evidence_found": {"type": "boolean"},
    "recovered": {"type": "boolean"},
    "observed_classification": {"type": ["string", "null"]},
    "expected_classification": {"type": ["string", "null"]},
    "concordant": {"type": ["boolean", "null"]},
    "false_positive": {"type": "boolean"},
    "false_negative": {"type": "boolean"},
    "competition_outcome": {"type": ["string", "null"]},
    "runtime_seconds": {"type": ["number", "null"]},
    "technical_failure": {"type": "boolean"},
    "failure_reason": {"type": ["string", "null"]},
    "status": {"enum": ["PASS", "FAIL", "NOT_EXECUTED", "REVIEW"]}
  },
  "additionalProperties": true
}
